# Local development config. Copy it to .env (git-ignored) and change the values:
#   cp .env.example .env
# docker compose reads .env automatically. Generate strong values with: openssl rand -hex 32
# Use letters, digits and dashes only: these end up inside connection strings and SQL.

MYSQL_ROOT_PASSWORD=dev-root-password-change-me

# One MySQL login per service, each limited to its own database
USER_DB_PASSWORD=dev-users-db-password
PRODUCT_DB_PASSWORD=dev-products-db-password
ORDER_DB_PASSWORD=dev-orders-db-password

REDIS_PASSWORD=dev-redis-password

# Signs login tokens (user-service) and verifies them (order-service). 32+ characters.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# Lets order-service call product-service's internal reservation API. 32+ characters.
INTERNAL_TOKEN=dev-only-internal-token-change-me-012345
